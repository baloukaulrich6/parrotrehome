# ParrotRehome.com — Environment Configuration
# Copy to .env and fill in real values for production.

# Database (current schema uses SQLite; PostgreSQL requires a schema migration)
DATABASE_URL="file:../var/demo.db"

# Authentication
NEXTAUTH_SECRET="change-me-to-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://parrotrehome.com"

# Google Ads + GA4
GOOGLE_ADS_ID=AW-XXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Video calls (Jitsi Meet)
JITSI_BASE_URL=https://meet.jit.si

# Demo: save messages only, never send live emails.
MAIL_TRANSPORT=preview
PAYMENT_EMAIL_LABEL=CHMK
# Persistent storage, outside deployment artifacts
MEDIA_DIR=./var/media
EMAIL_TEMPLATES_FILE=./var/email-templates.json
